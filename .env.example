# MongoDB connection string
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/quotation-builder

# JWT secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Node environment & local dev port
NODE_ENV=development
PORT=5001
